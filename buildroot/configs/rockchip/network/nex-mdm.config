# NEX-OS remote management (nex-agent): sync, DNS filter and firewall
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_CHRONY=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_JQ=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_OPENSSL=y
# openssl CLI: firma de la configuración, códigos de desbloqueo y actualizaciones
BR2_PACKAGE_LIBOPENSSL_BIN=y
# busybox httpd (UI local en 127.0.0.1:8080) con CGI para el relay UI -> agente
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES+="board/rockchip/common/nex-os/busybox.fragment"
