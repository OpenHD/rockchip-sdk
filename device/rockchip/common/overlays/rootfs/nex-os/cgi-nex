#!/bin/sh
# /cgi-bin/nex: relay de la UI local hacia nex-agent (Wi-Fi y código de desbloqueo).
#
# Corre como nex-www (busybox httpd -u). No ejecuta nada: valida el pedido y lo
# deja en la bandeja del agente (/run/nex-agent/inbox, solo escritura para este
# grupo). El agente vuelve a validar todo y publica el resultado en ui-state.json.
#
# Contra pedidos de otras páginas (una app web abierta en el kiosk): se exige
# Content-Type application/json, que obliga al navegador a un preflight CORS que
# este servidor no acepta, y el Origin, si viene, tiene que ser el de la UI.

INBOX=/run/nex-agent/inbox
UI_ORIGIN=http://127.0.0.1:8080

# busybox httpd no interpreta "Status:": la línea de estado la escribe el CGI.
reply() {
	printf 'HTTP/1.1 %s\r\nContent-Type: application/json\r\nCache-Control: no-store\r\n\r\n%s\n' "$1" "$2"
	exit 0
}

[ "${REQUEST_METHOD:-}" = POST ] || reply "405 Method Not Allowed" '{"ok":false,"error":"method"}'
case "${CONTENT_TYPE:-}" in
application/json | "application/json;"*) ;;
*) reply "415 Unsupported Media Type" '{"ok":false,"error":"content_type"}' ;;
esac
case "${HTTP_ORIGIN:-}" in
"" | "$UI_ORIGIN") ;;
*) reply "403 Forbidden" '{"ok":false,"error":"origin"}' ;;
esac
len=${CONTENT_LENGTH:-0}
case "$len" in '' | *[!0-9]*) reply "400 Bad Request" '{"ok":false,"error":"length"}' ;; esac
[ "$len" -ge 2 ] && [ "$len" -le 1024 ] || reply "413 Payload Too Large" '{"ok":false,"error":"length"}'

body=$(head -c "$len")
req=$(printf '%s' "$body" | jq -c '
	if type != "object" then empty
	elif .action == "wifi_scan" or .action == "wifi_forget" then {action}
	elif .action == "wifi_connect"
		and (.ssid | type == "string" and utf8bytelength >= 1 and utf8bytelength <= 32
			and (test("[\\x00-\\x1f]") | not))
		and (.psk | type == "string" and (. == "" or test("^[\\x20-\\x7e]{8,63}$")))
		then {action, ssid, psk}
	elif .action == "unlock_code" and (.code | type == "string" and test("^[0-9]{8}$")) then {action, code}
	else empty end' 2>/dev/null)
[ -n "$req" ] || reply "400 Bad Request" '{"ok":false,"error":"invalid"}'

[ -d "$INBOX" ] || reply "503 Service Unavailable" '{"ok":false,"error":"agent"}'
umask 027
f="$INBOX/$(date +%s).$$"
printf '%s\n' "$req" > "$f.tmp" && mv -f "$f.tmp" "$f.json" ||
	reply "503 Service Unavailable" '{"ok":false,"error":"agent"}'
reply "202 Accepted" '{"ok":true}'
